{
  "manifest_version": 3,
  "name": "ReFlow Parcel Optimizer",
  "version": "0.1.0",
  "description": "Optimize your warehouse parcels for minimum shipping costs",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "*://gtbuy.com/*",
    "*://*.gtbuy.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://gtbuy.com/*", "*://*.gtbuy.com/*"],
      "js": [
        "content/agents/gtbuy.js",
        "content/scraper.js",
        "content/simulator.js",
        "content/optimizer.js",
        "content/content.js"
      ],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
